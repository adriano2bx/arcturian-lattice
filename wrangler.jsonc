{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-intelligence-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "observability": { "enabled": true },

  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-intelligence",
      "database_id": "e800de96-65c2-47b6-ab63-f2afcefbc31e"
    }
  ]
}
