{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcturian-lattice",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "observability": { "enabled": true },

  "routes": [
    { "pattern": "lattice.deltabots.com.br/*", "zone_name": "deltabots.com.br" }
  ],

  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-intelligence",
      "database_id": "41e4352a-e3b3-438a-84f9-6aca37c56075"
    }
  ]
}
